Name: Command~
Trust: Builder~
Action:-
  local d = actor:get_descriptor()
  if not d then
    return
  end
  local phrases = parse(line, {"edit", "erase", "stat"})
  if not phrases or #phrases ~~= 1 then
    action("Failed", A.TO_CHAR, "Usage: command edit|erase|stat <name>.", actor)
    return
  end
  local target_phrase = phrases[1]
  local mode = target_phrase:get_delimiter():lower()
  local words = target_phrase:get_words()
  if (mode ~~= "edit" and mode ~~= "erase" and mode ~~= "stat")
      or #words ~~= 1
      or not target_phrase:is_single() then
    action("Failed", A.TO_CHAR, "Usage: command edit|erase|stat <name>.", actor)
    return
  end
  local name = words[1]
  local target = get_commands():get(name)
  if mode == "edit" then
    if target then
      d:set_edit_command(target)
    else
      local edit = d:set_edit_command(nil)
      edit:set_name(name)
    end
    d:push_state("Command")
  elseif mode == "erase" then
    local player = actor:get_player()
    if not player or not trust_allows(player:get_trust(), "Wizard") then
      action("Failed", A.TO_CHAR, "You're not allowed to erase ${D.Text}!", actor, name)
      return
    end
    if not target then
      action("Failed", A.TO_CHAR, "You can't seem to find ${D.Text}!", actor, name)
      return
    end
    get_commands():erase(name)
    action("Okay", A.TO_CHAR | A.NOREPEAT, "Erased ${D.Text}!", actor, name)
  elseif mode == "stat" then
    if not target then
      action("Failed", A.TO_CHAR, "You can't seem to find ${D.Text}!", actor, name)
      return
    end
    d:print_format("%sName%s:%s %s%s%s\r\n",
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL, Q.TEXT, target:get_name(), Q.NORMAL)
    d:print_format("%sKeywords%s:%s %s%s%s\r\n",
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL, Q.TEXT,
      table.concat(target:get_keywords(), ", "), Q.NORMAL)
    d:print_format("%sTrust%s:%s %s%s%s\r\n",
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL, Q.TEXT, target:get_trust(), Q.NORMAL)
    local action_text = target:get_action()
    d:print_format("%sAction%s:-%s\r\n",
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL)
    if action_text ~~= "" then
      action_text = action_text:gsub("[\r\n]+$", "")
      d:print_format("%s%s%s\r\n", Q.TEXT, action_text, Q.NORMAL)
    end
  end
  ~
~
