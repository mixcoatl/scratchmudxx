Name: Autosay~
Action:-
  local d = actor:get_descriptor()
  if not d then
    return
  end
  local player = actor:get_player()
  if not player then
    return
  end
  local user = d:get_user()
  local by = user and user:get_name() or player:get_name()
  if player:has_preference("AutoSay") then
    player:erase_preference("AutoSay")
    d:print_format("%sAutoSay off.%s\r\n", Q.OKAY, Q.NORMAL)
  else
    player:add_preference("AutoSay")
    d:print_format("%sAutoSay on.%s\r\n", Q.OKAY, Q.NORMAL)
  end
  player:set_modified(os.time())
  player:set_modified_by(by)
  get_players():save(player:get_name())
  ~
~
