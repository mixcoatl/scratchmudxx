Name: Commands~
Action:-
  local d = actor:get_descriptor()
  if not d then
    return
  end
  local player = actor:get_player()
  if not player then
    return
  end
  local cells = {}
  for _, id in ipairs(get_commands():get_ids()) do
    local c = get_commands():get(id)
    if c then
      local perms = c:get_permissions()
      local allowed = #perms == 0
      if not allowed then
        for _, p in ipairs(perms) do
          if player:has_permission(p) then
            allowed = true
            break
          end
        end
      end
      if allowed then
        local name = string.lower(c:get_name())
        local color = Q.TEXT
        if #perms ~~= 0 then
          color = Q.RESTRICTED
        elseif c:get_social() ~~= nil then
          color = Q.SOCIAL
        end
        cells[#cells + 1] = color .. name .. Q.NORMAL
      end
    end
  end
  if #cells == 0 then
    return
  end
  d:print_columns(cells)
  ~
~
