Name: Grant~
Trust: Wizard~
Action:-
  local d = actor:get_descriptor()
  if not d then
    return
  end
  local io = require("io")
  local thing = require("thing")
  local who, trust_name = line:match("^%s*(%S+)%s+(%S+)")
  if not who or not trust_name then
    io.usage(d, Q, "grant <player> <trust>")
    return
  end
  trust_name = parse_trust(trust_name)
  if not trust_name then
    io.fail(d, Q, "Unknown trust.")
    return
  end
  local player = get_players():get(who)
  if not player then
    io.fail(d, Q, "No such player.")
    return
  end
  local granter_trust = "Player"
  local actor_player = actor:get_player()
  if actor_player then
    granter_trust = actor_player:get_trust()
  end
  if not trust_allows(granter_trust, trust_name) then
    io.fail(d, Q, "Insufficient trust.")
    return
  end
  player:set_trust(trust_name)
  thing.set_audit_metadata(player, actor)
  get_players():save(player:get_name())
  io.okay(d, Q, "Granted " .. trust_name .. " trust to " .. player:get_name() .. ".")
  ~
~
