Name: Socials~
Action:-
  local d = get_descriptor_for(actor)
  if not d then
    return
  end
  local cells = {}
  for _, id in ipairs(get_commands():get_ids()) do
    local c = get_commands():get(id)
    if c and c:get_social() ~~= nil then
      local perms = c:get_permissions()
      local allowed = #perms == 0
      if not allowed then
        for _, p in ipairs(perms) do
          if actor:has_permission(p) then
            allowed = true
            break
          end
        end
      end
      if allowed then
        local name = string.lower(c:get_name())
        local color = Q.SOCIAL
        if #perms ~~= 0 then
          color = Q.RESTRICTED
        end
        cells[#cells + 1] = color .. name .. Q.NORMAL
      end
    end
  end
  if #cells == 0 then
    return
  end
  d:print_columns(cells)
  ~
~
