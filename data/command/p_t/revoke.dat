Name: Revoke~
Trust: Wizard~
Action:-
  local d = actor:get_descriptor()
  if not d then
    return
  end
  local io = require("io")
  local thing = require("thing")
  local who, trust_name = line:match("^%s*(%S+)%s+(%S+)")
  if not who or not trust_name then
    io.usage(d, Q, "revoke <player> <trust>")
    return
  end
  trust_name = parse_trust(trust_name)
  if not trust_name then
    io.fail(d, Q, "Unknown trust.")
    return
  end
  local names = get_trust_names()
  local revoke_idx
  for i, name in ipairs(names) do
    if name == trust_name then
      revoke_idx = i
      break
    end
  end
  local player = get_players():get(who)
  if not player then
    io.fail(d, Q, "No such player.")
    return
  end
  if not trust_allows(player:get_trust(), trust_name) then
    io.fail(d, Q, "Player does not have that trust.")
    return
  end
  local new_trust = revoke_idx > 1 and names[revoke_idx - 1] or "Player"
  player:set_trust(new_trust)
  thing.set_audit_metadata(player, actor)
  get_players():save(player:get_name())
  io.okay(d, Q, "Revoked " .. trust_name .. " from " .. player:get_name()
    .. "; trust is now " .. new_trust .. ".")
  ~
~
