Hooks:
  Focus:-
    d:print_format("%sEnter a member name to add%s:%s ", Q.PROMPT, Q.PUNCTUATION, Q.NORMAL);
    ~
  Received:-
    local edit = d:get_edit_enumeration();
    if not edit then
      d:pop_state();
    else
      local member = line:match("%S+") or "";
      if member == "" then
        d:print_format("%sAdd cancelled.%s\r\n", Q.FAILED, Q.NORMAL);
        d:pop_state();
      else
        edit:add_member(member);
        d:pop_state();
      end
    end
    ~
  ~
Name: EnumerationMemberAdd~
~
