Hooks:
  Focus:-
    local edit = d:get_edit_command();
    if not edit then
      d:pop_state();
      return;
    end
    local ed = d:get_editor();
    if ed then
      if not ed:is_aborted() then
        edit:set_action(ed:get_text());
      end
      d:clear_editor();
      d:pop_state();
      return;
    end
    d:start_editor(edit:get_action(), "action");
    ~
  ~
Name: CommandAction~
~
