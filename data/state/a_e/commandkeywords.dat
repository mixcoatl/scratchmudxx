Hooks:
  Focus:-
    d:print_format("%sEnter keywords (comma-separated)%s:%s ", Q.PROMPT, Q.PUNCTUATION, Q.NORMAL);
    ~
  Received:-
    local edit = d:get_edit_command();
    if not edit then
      d:pop_state();
      return;
    end
    if line:match("%S+") == nil then
      d:print_format("%sKeywords entry cancelled.%s\r\n", Q.FAILED, Q.NORMAL);
      d:pop_state();
      return;
    end
    local keywords = {};
    for part in string.gmatch(line, "[^,]+") do
      local word = part:match("^%s*(.-)%s*$");
      if word ~~= "" then
        keywords[#keywords + 1] = word;
      end
    end
    edit:set_keywords(keywords);
    d:pop_state();
    ~
  ~
Name: CommandKeywords~
~
