Hooks:
  Focus:-
    local edit = d:get_edit_command();
    if not edit then
      require("io").fail(d, Q, "No command draft; returning.");
      d:pop_state();
      return;
    end
    local kws = edit:get_keywords();
    local kwtext = table.concat(kws, ", ");
    local trust = edit:get_trust();
    local social = edit:get_social();
    local found = "";
    local found_auto = "";
    local no_argument = "";
    if social then
      found = social:get_found();
      found_auto = social:get_found_auto();
      no_argument = social:get_no_argument();
    end
    d:clear_menu();
    local m = d:ensure_menu();
    m:set_title("Command", edit:get_name(), "name", "<New>");
    m:add_choices();
    m:add_field("1", "Name", edit:get_name(), "name");
    m:add_field("2", "Keywords", kwtext);
    m:add_block("3", "Action", edit:get_action());
    m:add_field("4", "Trust", trust, "enum", "<Empty>");
    m:add_named_choices("Social Information");
    m:add_field("5", "Found", found);
    m:add_field("6", "Found Auto", found_auto);
    m:add_field("7", "No Argument", no_argument);
    m:add_item("8", "Delete Social Data.");
    m:add_choices();
    m:add_item("q", "Save and quit.");
    m:add_item("x", "Abort without saving.");
    m:set_prompt("Enter choice");
    d:print_menu();
    ~
  Received:-
    local edit = d:get_edit_command();
    if not edit then
      d:pop_state();
      return;
    end
    local m = d:get_menu();
    local key = m:match_key(line);
    if key == "1" then
      d:push_state("CommandName");
    elseif key == "2" then
      d:push_state("CommandKeywords");
    elseif key == "3" then
      d:push_state("CommandAction");
    elseif key == "4" then
      d:push_state("CommandTrust");
    elseif key == "5" then
      if not edit:get_social() then
        edit:create_social();
      end
      d:push_state("CommandFound");
    elseif key == "6" then
      if not edit:get_social() then
        edit:create_social();
      end
      d:push_state("CommandFoundAuto");
    elseif key == "7" then
      if not edit:get_social() then
        edit:create_social();
      end
      d:push_state("CommandNoArgument");
    elseif key == "8" then
      edit:set_social(nil);
      d:set_state("Command");
    elseif key == "q" then
      local name = edit:get_name();
      if name == "" then
        require("io").fail(d, Q, "Name is required before saving.");
        d:set_state("Command");
      else
        require("thing").set_audit_metadata(edit, d, d:get_edit_name() == "");
        get_commands():store(name, edit);
        local original = d:get_edit_name();
        if original ~~= "" and original:lower() ~~= name:lower() then
          get_commands():erase(original);
        end
        d:clear_edit_command();
        d:pop_state();
      end
    elseif key == "x" then
      d:clear_edit_command();
      d:pop_state();
    else
      require("io").show_unknown_choice(d, Q, "Command");
    end
    ~
  ~
Name: Command~
~
