Hooks:
  Focus:-
    require("io").prompt(d, Q, "Enter the room name");
    ~
  Received:-
    local edit = d:get_edit_room();
    if not edit then
      d:pop_state();
      return;
    end
    local name = line:match("^%s*(.-)%s*$");
    if name == "" then
      d:set_state("Room");
    else
      edit:set_name(name);
      d:set_state("Room");
    end
    ~
~
Name: RoomName~
~
