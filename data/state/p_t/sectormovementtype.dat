Hooks:
  Focus:-
    local edit = d:get_edit_sector();
    if not edit then
      d:pop_state();
      return;
    end
    d:clear_menu();
    local m = d:ensure_menu();
    m:set_title("Movement Type", edit:get_name(), "name", "<New>");
    m:add_named_choices("Movement Type");
    local names = get_movement_names();
    for i, name in ipairs(names) do
      m:add_item(tostring(i), name);
    end
    m:add_choices();
    m:add_item("x", "Return.");
    m:set_prompt("Enter choice");
    d:print_menu();
    ~
  Received:-
    local edit = d:get_edit_sector();
    if not edit then
      d:pop_state();
      return;
    end
    local m = d:get_menu();
    local key = m:match_key(line);
    if key == "x" then
      d:pop_state();
      return;
    end
    if not key then
      if line:match("%S+") then
        require("io").show_unknown_choice(d, Q, "SectorMovementType");
      else
        d:pop_state();
      end
      return;
    end
    local names = get_movement_names();
    local n = tonumber(key);
    local movement = n and names[n];
    if movement then
      edit:set_movement_type(movement);
    else
      require("io").show_unknown_choice(d, Q, "SectorMovementType");
      return;
    end
    d:pop_state();
    ~
~
Name: SectorMovementType~
~
