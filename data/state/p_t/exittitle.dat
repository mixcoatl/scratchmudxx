Hooks:
  Focus:-
    local edit = d:get_edit_exit();
    if not edit then
      d:pop_state();
      return;
    end
    require("io").prompt(d, Q, "Title");
    ~
  Received:-
    local edit = d:get_edit_exit();
    if not edit then
      d:pop_state();
      return;
    end
    edit:set_title(line);
    d:set_state("Exit");
    ~
~
Name: ExitTitle~
~
