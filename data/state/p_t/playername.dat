Hooks:
  Focus:-
    require("io").prompt(d, Q, "New player name");
    ~
  Received:-
    local edit = d:get_edit_player();
    if not edit then
      d:set_state("Lobby");
      return;
    end
    local name = line:match("%S+") or "";
    if name == "" then
      d:print("Player name entry cancelled.\r\n");
      d:pop_state();
    elseif name:lower() == "new" then
      require("io").fail(d, Q, "That name is reserved.");
      d:set_state("PlayerName");
    elseif not name:match("^[%w_]+$") then
      require("io").fail(d, Q,
        "Player names may contain only letters, digits, and underscores.");
      d:set_state("PlayerName");
    elseif get_players():get(name) then
      require("io").fail(d, Q, "That name is already taken.");
      d:set_state("PlayerName");
    else
      edit:set_name(name);
      d:pop_state();
    end
    ~
  ~
Name: PlayerName~
~
