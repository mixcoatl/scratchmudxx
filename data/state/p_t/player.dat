Hooks:
  Focus:-
    local edit = d:get_edit_player();
    if not edit then
      require("io").fail(d, Q, "No player draft; returning.");
      d:pop_state();
      return;
    end
    d:clear_menu();
    local m = d:ensure_menu();
    local gender = edit:get_gender() or "";
    m:set_title("Player", edit:get_name(), "name", "<New>");
    m:add_choices();
    m:add_field("1", "Name", edit:get_name(), "name");
    m:add_field("2", "Gender", gender, "enum");
    local autosay = "No";
    if edit:has_preference("AutoSay") then
      autosay = "Yes";
    end
    m:add_field("3", "AutoSay", autosay, "yesno");
    local norepeat = "No";
    if edit:has_preference("NoRepeat") then
      norepeat = "Yes";
    end
    m:add_field("4", "NoRepeat", norepeat, "yesno");
    m:add_choices();
    m:add_item("q", "Save and quit.");
    m:add_item("x", "Abort without saving.");
    m:set_prompt("Enter choice");
    d:print_menu();
    ~
  Received:-
    local edit = d:get_edit_player();
    if not edit then
      d:pop_state();
      return;
    end
    local m = d:get_menu();
    local key = m:match_key(line);
    if key == "1" then
      if d:get_edit_name() == "" then
        d:push_state("PlayerName");
      else
        require("io").fail(d, Q, "You can't change an existing player's name.");
        d:set_state("Player");
      end
    elseif key == "2" then
      d:push_state("PlayerGender");
    elseif key == "3" then
      if edit:has_preference("AutoSay") then
        edit:erase_preference("AutoSay");
      else
        edit:add_preference("AutoSay");
      end
      d:set_state("Player");
    elseif key == "4" then
      if edit:has_preference("NoRepeat") then
        edit:erase_preference("NoRepeat");
      else
        edit:add_preference("NoRepeat");
      end
      d:set_state("Player");
    elseif key == "q" then
      local name = edit:get_name();
      local is_new = d:get_edit_name() == "";
      if name == "" then
        require("io").fail(d, Q, "Name is required before saving.");
        d:set_state("Player");
        return;
      end
      require("thing").set_audit_metadata(edit, d, is_new);
      get_players():store(name, edit);
      if is_new then
        local user = d:get_user();
        if user then
          user:add_player(name);
          get_users():save(user:get_name());
        end
      end
      d:clear_edit_player();
      if is_new then
        d:set_state("Lobby");
      else
        d:pop_state();
      end
    elseif key == "x" then
      local is_new = d:get_edit_name() == "";
      d:clear_edit_player();
      if is_new then
        d:set_state("Lobby");
      else
        d:pop_state();
      end
    else
      require("io").show_unknown_choice(d, Q, "Player");
    end
    ~
  ~
Name: Player~
~
