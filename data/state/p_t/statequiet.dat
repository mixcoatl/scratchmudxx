Hooks:
  Focus:-
    require("io").prompt(d, Q, "Quiet (Yes/No)");
    ~
  Received:-
    local edit = d:get_edit_state();
    if not edit then
      d:pop_state();
      return;
    end
    local ans = (line:match("%S+") or ""):lower();
    if ans == "" then
      require("io").fail(d, Q, "Quiet entry cancelled.");
      d:pop_state();
    elseif ans == "y" or ans == "yes" then
      edit:set_quiet(true);
      d:pop_state();
    elseif ans == "n" or ans == "no" then
      edit:set_quiet(false);
      d:pop_state();
    else
      require("io").fail(d, Q, "Enter Yes or No.");
      d:set_state("StateQuiet");
    end
    ~
  ~
Name: StateQuiet~
~
