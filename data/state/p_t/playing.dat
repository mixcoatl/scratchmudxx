Hooks:
  Received:-
    local user = d:get_user();
    local who = d:get_name();
    if user then
      who = user:get_name();
    end
    local word = line:match("%w+") or "";
    local word_lower = word:lower();
    if word_lower == "quit" then
      d:set_state("Lobby");
    elseif word_lower == "shutdown" then
      broadcast("Game is shutting down.\r\n");
      shutdown();
    elseif line ~~= "" then
      broadcast("From " .. who .. ": " .. line .. "\r\n");
    end
    ~
  ~
Name: Playing~
StateBits:
  Prompt: Yes~
  ~
~
