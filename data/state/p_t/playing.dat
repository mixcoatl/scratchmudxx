Hooks:
  Focus:-
    local user = d:get_user();
    local who = d:get_name();
    if user then
      who = user:get_name();
    end
    d:print("Welcome to ScratchMUD, " .. who .. "!\r\n");
    if user then
      local last_logout = user:get_last_logout();
      if last_logout and last_logout > 0 then
        d:print(string.format("Your last visit ended %s.\r\n",
          date(last_logout)));
      end
    end
    ~
  Received:-
    local user = d:get_user();
    local who = d:get_name();
    if user then
      who = user:get_name();
    end
    local word = line:match("%w+") or "";
    local word_lower = word:lower();
    if word_lower == "quit" then
      d:close();
      broadcast(who .. " has disconnected.\r\n");
    elseif word_lower == "shutdown" then
      broadcast("Game is shutting down.\r\n");
      shutdown();
    elseif line ~~= "" then
      broadcast("From " .. who .. ": " .. line .. "\r\n");
    end
    ~
  ~
Name: Playing~
StateBits:
  Prompt: Yes~
  ~
~
