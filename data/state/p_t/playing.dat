Hooks:
  Focus:-
    local user = d:get_user();
    local who = d:get_name();
    if user then
      who = user:get_name();
    end

    d:print(string.format("%sWelcome to ScratchMUD, %s%s%s!%s\r\n",
      Q.PROMPT, Q.EMPHASIS, who, Q.PROMPT, Q.NORMAL));

    if user then
      local last_logout = user:get_last_logout();
      if last_logout and last_logout > 0 then
        d:print(string.format("%sYour last visit ended %s%s%s.%s\r\n",
          Q.PROMPT, Q.EMPHASIS, date(last_logout), Q.PROMPT, Q.NORMAL));
      end
    end
    ~
  Received:-
    local user = d:get_user();
    local who = d:get_name();
    if user then
      who = user:get_name();
    end
    local word = line:match("%w+") or "";
    local word_lower = word:lower();
    if word_lower == "quit" then
      d:set_state("Lobby");
    elseif word_lower == "shutdown" then
      broadcast("Game is shutting down.\r\n");
      shutdown();
    elseif line ~~= "" then
      broadcast("From " .. who .. ": " .. line .. "\r\n");
    end
    ~
  ~
Name: Playing~
StateBits:
  Prompt: Yes~
  ~
~
