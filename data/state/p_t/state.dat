Hooks:
  Focus:-
    local edit = d:get_edit_state();
    if not edit then
      d:print_format("%sNo state draft; returning.%s\r\n", Q.FAILED, Q.NORMAL);
      d:pop_state();
      return;
    end
    d:clear_menu();
    local m = d:ensure_menu();
    m:set_title("State", edit:get_name(), "name", "<New>");
    m:add_choices();
    m:add_field("1", "Name", edit:get_name(), "name");
    m:add_named_choices("Hooks");
    m:add_block("2", "Focus", edit:get_focus_hook());
    m:add_block("3", "FocusLost", edit:get_focus_lost_hook());
    m:add_block("4", "Received", edit:get_received_hook());
    local quiet = "No";
    if edit:is_quiet() then
      quiet = "Yes";
    end
    local prompt = "No";
    if edit:is_prompt() then
      prompt = "Yes";
    end
    m:add_choices();
    m:add_field("5", "Quiet", quiet, "yesno");
    m:add_field("6", "Prompt", prompt, "yesno");
    m:add_choices();
    m:add_item("q", "Save and quit.");
    m:add_item("x", "Abort without saving.");
    m:set_prompt("Enter choice");
    d:print_menu();
    ~
  Received:-
    local edit = d:get_edit_state();
    if not edit then
      d:pop_state();
      return;
    end
    local m = d:get_menu();
    local key = m:match_key(line);
    if key == "1" then
      d:push_state("StateName");
    elseif key == "2" then
      d:push_state("StateFocus");
    elseif key == "3" then
      d:push_state("StateFocusLost");
    elseif key == "4" then
      d:push_state("StateReceived");
    elseif key == "5" then
      d:push_state("StateQuiet");
    elseif key == "6" then
      d:push_state("StatePrompt");
    elseif key == "q" then
      local name = edit:get_name();
      if name == "" then
        d:print_format("%sName is required before saving.%s\r\n", Q.FAILED, Q.NORMAL);
        d:set_state("State");
      else
        local modified = os.time();
        local modified_by = "system";
        if d:get_user() then
          modified_by = d:get_user():get_name();
        end
        if d:get_edit_name() == "" then
          edit:set_created(modified);
          edit:set_created_by(modified_by);
        end
        edit:set_modified(modified);
        edit:set_modified_by(modified_by);
        get_states():store(name, edit);
        local original = d:get_edit_name();
        if original ~~= "" and original:lower() ~~= name:lower() then
          get_states():erase(original);
        end
        d:clear_edit_state();
        d:pop_state();
      end
    elseif key == "x" then
      d:clear_edit_state();
      d:pop_state();
    else
      d:print_format("%sUnknown choice.%s\r\n", Q.FAILED, Q.NORMAL);
      d:set_state("State");
    end
    ~
  ~
Name: State~
~
