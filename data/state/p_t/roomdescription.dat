Hooks:
  Focus:-
    local edit = d:get_edit_room();
    if not edit then
      d:pop_state();
      return;
    end
    local ed = d:get_editor();
    if ed then
      if not ed:is_aborted() then
        edit:set_description(ed:get_text());
      end
      d:clear_editor();
      d:set_state("Room");
      return;
    end
    d:start_editor(edit:get_description(), "description");
    ~
~
Name: RoomDescription~
~
