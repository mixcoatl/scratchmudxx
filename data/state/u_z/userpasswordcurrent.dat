Hooks:
  Focus:-
    require("io").prompt(d, Q, "Current password");
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:pop_state();
    elseif line == "" then
      d:print("Password change cancelled.\r\n");
      d:set_edit_string("");
      d:pop_state();
    else
      local hash = edit:get_password();
      if hash == "" or hash ~~= crypt(line, hash) then
        require("io").fail(d, Q, "Incorrect password.");
        d:set_state("UserPasswordCurrent");
      else
        d:push_state("UserPassword");
      end
    end
    ~
  ~
Name: UserPasswordCurrent~
StateBits:
  Quiet: Yes~
  ~
~
