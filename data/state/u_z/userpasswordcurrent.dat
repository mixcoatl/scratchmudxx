Hooks:
  Focus:-
    d:print(string.format("%sCurrent password:%s ", Q.PROMPT, Q.NORMAL));
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_state("User");
    elseif line == "" then
      d:print("Password change cancelled.\r\n");
      d:set_edit_string("");
      d:set_state("User");
    else
      local hash = edit:get_password();
      if hash == "" or hash ~~= crypt(line, hash) then
        d:print(string.format("%sIncorrect password.%s\r\n", Q.FAILED, Q.NORMAL));
        d:set_state("UserPasswordCurrent");
      else
        d:set_state("UserPassword");
      end
    end
    ~
  ~
Name: UserPasswordCurrent~
StateBits:
  Quiet: Yes~
  ~
~
