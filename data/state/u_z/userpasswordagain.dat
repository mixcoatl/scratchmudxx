Hooks:
  Focus:-
    d:print_format("%sConfirm new password:%s ", Q.PROMPT, Q.NORMAL);
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_edit_string("");
      d:pop_state_until("User");
    elseif line == "" then
      d:print("Password entry cancelled.\r\n");
      d:set_edit_string("");
      d:pop_state_until("User");
    else
      local pending = d:get_edit_string();
      local again = crypt(line, pending);
      if again ~~= pending then
        d:print_format("%sPasswords do not match.%s\r\n", Q.FAILED, Q.NORMAL);
        d:set_edit_string("");
        d:pop_state();
      elseif not edit:set_password(line) then
        d:print_format("%sCould not set password.%s\r\n", Q.FAILED, Q.NORMAL);
        d:set_edit_string("");
        d:pop_state();
      else
        d:set_edit_string("");
        d:print_format("%sPassword updated.%s\r\n", Q.OKAY, Q.NORMAL);
        d:pop_state_until("User");
      end
    end
    ~
  ~
Name: UserPasswordAgain~
StateBits:
  Quiet: Yes~
  ~
~
