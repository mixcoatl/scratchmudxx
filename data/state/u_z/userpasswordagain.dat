Hooks:
  Focus:-
    d:print("Confirm new password: ");
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_edit_string("");
      d:set_state("User");
    elseif line == "" then
      d:print("Password entry cancelled.\r\n");
      d:set_edit_string("");
      d:set_state("User");
    else
      local pending = d:get_edit_string();
      local again = crypt(line, pending);
      if again ~~= pending then
        d:print("Passwords do not match.\r\n");
        d:set_edit_string("");
        d:set_state("UserPassword");
      elseif not edit:set_password(line) then
        d:print("Could not set password.\r\n");
        d:set_edit_string("");
        d:set_state("UserPassword");
      else
        d:set_edit_string("");
        d:print("Password updated.\r\n");
        d:set_state("User");
      end
    end
    ~
  ~
Name: UserPasswordAgain~
StateBits:
  Quiet: Yes~
  ~
~
