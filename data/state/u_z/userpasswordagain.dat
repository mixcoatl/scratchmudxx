Hooks:
  Focus:-
    require("io").prompt(d, Q, "Confirm new password");
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_edit_string("");
      d:pop_state_until("User");
    elseif line == "" then
      d:print("Password entry cancelled.\r\n");
      d:set_edit_string("");
      d:pop_state_until("User");
    else
      local pending = d:get_edit_string();
      local again = crypt(line, pending);
      if again ~~= pending then
        require("io").fail(d, Q, "Passwords do not match.");
        d:set_edit_string("");
        d:pop_state();
      elseif not edit:set_password(line) then
        require("io").fail(d, Q, "Could not set password.");
        d:set_edit_string("");
        d:pop_state();
      else
        d:set_edit_string("");
        require("io").okay(d, Q, "Password updated.");
        d:pop_state_until("User");
      end
    end
    ~
  ~
Name: UserPasswordAgain~
StateBits:
  Quiet: Yes~
  ~
~
