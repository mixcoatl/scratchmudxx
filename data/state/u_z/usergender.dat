Hooks:
  Focus:-
    d:clear_menu();
    local m = d:ensure_menu();
    m:set_title("Gender");
    m:add_choices();
    for i, name in ipairs(get_gender_names()) do
      m:add_item(tostring(i), name);
    end
    m:set_prompt("Enter choice");
    d:print_menu();
    ~
  Received:-
    if line == "" then
      d:print_format("%sGender entry cancelled.%s\r\n", Q.FAILED, Q.NORMAL);
      d:pop_state();
      return;
    end
    local m = d:get_menu();
    local key = m:match_key(line);
    local names = get_gender_names();
    local name = key and names[tonumber(key)];
    if not name then
      d:print_format("%sUnknown choice.%s\r\n", Q.FAILED, Q.NORMAL);
      d:set_state("UserGender");
      return;
    end
    local edit = d:get_edit_user();
    if edit then
      edit:set_gender(name);
    end
    d:pop_state();
    ~
  ~
Name: UserGender~
~
