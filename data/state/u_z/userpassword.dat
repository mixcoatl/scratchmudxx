Hooks:
  Focus:-
    require("io").prompt(d, Q, "New password");
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_edit_string("");
      d:pop_state_until("User");
    elseif line == "" then
      d:print("Password entry cancelled.\r\n");
      d:set_edit_string("");
      d:pop_state_until("User");
    else
      d:set_edit_string(crypt(line));
      d:push_state("UserPasswordAgain");
    end
    ~
  ~
Name: UserPassword~
StateBits:
  Quiet: Yes~
  ~
~
