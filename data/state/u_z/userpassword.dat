Hooks:
  Focus:-
    d:print("New password: ");
    ~
  Received:-
    local edit = d:get_edit_user();
    if not edit then
      d:set_edit_string("");
      d:set_state("User");
    elseif line == "" then
      d:print("Password entry cancelled.\r\n");
      d:set_edit_string("");
      d:set_state("User");
    else
      d:set_edit_string(crypt(line));
      d:set_state("UserPasswordAgain");
    end
    ~
  ~
Name: UserPassword~
StateBits:
  Quiet: Yes~
  ~
~
