Hooks:
  Focus:-
    d:print_format("%sUsername %s(%sor \"%sNEW%s\"%s):%s ",
      Q.PROMPT, Q.PUNCTUATION, Q.PROMPT, Q.EMPHASIS,
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL);
    ~
  Received:-
    local name = line:match("%S+") or "";
    local name_lower = name:lower();
    local user = get_users():get(name);
    if name_lower == "" then
      d:print_format("%sPlease enter a username.%s\r\n", Q.FAILED, Q.NORMAL);
      d:set_state("LoginUser");
    elseif name_lower == "new" then
      d:set_edit_user();
      d:push_state("User");
    elseif user then
      d:set_edit_string(name);
      d:set_state("LoginPassword");
    else
      d:print_format("%sUnknown user.%s\r\n", Q.FAILED, Q.NORMAL);
      d:set_state("LoginUser");
    end
    ~
  ~
Name: LoginUser~
~
