Hooks:
  Focus:-
    local user = d:get_user();
    if not user then
      d:print(string.format("%sNot logged in.%s\r\n", Q.FAILED, Q.NORMAL));
      d:set_state("LoginUser");
      return;
    end
    d:print(string.format(
      "%sLobby%s:%s\r\n" ..
      "  %s01%s) %sEnter game.%s\r\n" ..
      "  %s02%s) %sEdit user record.%s\r\n" ..
      "  %s03%s) %sDelete user record.%s\r\n" ..
      "  %s04%s) %sQuit.%s\r\n" ..
      "%sChoice%s:%s ",
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL,
      Q.KEY, Q.PUNCTUATION, Q.PROMPT, Q.NORMAL,
      Q.KEY, Q.PUNCTUATION, Q.PROMPT, Q.NORMAL,
      Q.KEY, Q.PUNCTUATION, Q.PROMPT, Q.NORMAL,
      Q.KEY, Q.PUNCTUATION, Q.PROMPT, Q.NORMAL,
      Q.PROMPT, Q.PUNCTUATION, Q.NORMAL));
    ~
  Received:-
    local user = d:get_user();
    if not user then
      d:print(string.format("%sNot logged in.%s\r\n", Q.FAILED, Q.NORMAL));
      d:set_state("LoginUser");
      return;
    end
    local word = line:match("%S+") or "";
    local choice = word:match("^%d+$") and tonumber(word);
    if choice == 1 then
      d:set_state("Playing");
    elseif choice == 2 then
      d:set_edit_user(user);
      d:set_state("User");
    elseif choice == 3 then
      d:set_state("LobbyDelete");
    elseif choice == 4 then
      local who = user:get_name();
      d:close();
      broadcast(who .. " has disconnected.\r\n");
    else
      d:print(string.format("%sUnknown choice.%s\r\n", Q.FAILED, Q.NORMAL));
      d:set_state("Lobby");
    end
    ~
  ~
Name: Lobby~
~
