Hooks:
  Focus:-
    d:print("Enable ANSI color? [Y/n]: ");
    ~
  Received:-
    local word = line:match("%w+") or "";
    local word_lower = word:lower();
    if word_lower == "" or word_lower == "yes" or word_lower == "y" then
      d:set_color(true);
      d:set_state("LoginUser");
    elseif word_lower == "no" or word_lower == "n" then
      d:set_color(false);
      d:set_state("LoginUser");
    else
      d:print("Please answer Y or N.\r\n");
      d:set_state("Login");
    end
    ~
  ~
Name: Login~
~
