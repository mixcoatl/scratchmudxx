Hooks:
  Focus:-
    d:print(string.format("%sPassword:%s ", Q.PROMPT, Q.NORMAL));
    ~
  Received:-
    local name = d:get_edit_string();
    local user = get_users():get(name);
    if not user then
      d:print(string.format("%sUnknown user.%s\r\n", Q.FAILED, Q.NORMAL));
      d:set_edit_string("");
      d:set_state("LoginUser");
    else
      local hash = user:get_password();
      if hash == "" or hash ~~= crypt(line, hash) then
        d:print(string.format("%sIncorrect password.%s\r\n", Q.FAILED, Q.NORMAL));
        d:set_state("LoginUser");
      else
        d:set_edit_string("");
        d:login(user);
        d:set_state("Lobby");
      end
    end
    ~
  ~
Name: LoginPassword~
StateBits:
  Quiet: Yes~
  ~
~
