Hooks:
  Focus:-
    d:print("Password: ");
    ~
  Received:-
    local name = d:get_edit_string();
    local user = get_users():get(name);
    if not user then
      d:print("Unknown user.\r\n");
      d:set_edit_string("");
      d:set_state("LoginUser");
    else
      local hash = user:get_password();
      if hash == "" or hash ~~= crypt(line, hash) then
        d:print("Incorrect password.\r\n");
        d:set_state("LoginUser");
      else
        d:set_edit_string("");
        d:login(user);
        d:set_state("Playing");
      end
    end
    ~
  ~
Name: LoginPassword~
StateBits:
  Quiet: Yes~
  ~
~
