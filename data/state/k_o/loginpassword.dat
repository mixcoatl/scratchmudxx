Hooks:
  Focus:-
    require("io").prompt(d, Q, "Password");
    ~
  Received:-
    local name = d:get_edit_string();
    local user = get_users():get(name);
    if not user then
      require("io").fail(d, Q, "Unknown user.");
      d:set_edit_string("");
      d:set_state("LoginUser");
    else
      local hash = user:get_password();
      if hash == "" or hash ~~= crypt(line, hash) then
        require("io").fail(d, Q, "Incorrect password.");
        d:set_state("LoginUser");
      else
        d:set_edit_string("");
        d:login(user);
        d:set_state("Lobby");
      end
    end
    ~
  ~
Name: LoginPassword~
StateBits:
  Quiet: Yes~
  ~
~
